model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectLake - lh_dev_hackathon"]

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","WebModelingEdit","MCP-PBIModeling-Hosted","CopilotTooling","TMDLView_Desktop","RemoteModeling"]

ref table dimchannel
ref table dimdate
ref table dimlocation
ref table dimproduct
ref table dimreportingperiod
ref table factinventorysnapshot
ref table factsales
ref table _SM_Measures

ref cultureInfo en-US

